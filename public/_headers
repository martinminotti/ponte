# Netlify e Cloudflare Pages leggono questo file. Se cambi lo script inline in index.html,
# aggiorna l'hash sha256 qui sotto (vedi README, sezione Sicurezza).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-24CdtABD0Zlqn2bPY5EjOKYLNiLb3N+RtL46RUhrwBs='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
